{
  "name": "llmcli",
  "version": "0.3.0",
  "private": true,
  "description": "Terminal coding agent for local and hosted language models",
  "scripts": {
    "start": "bun run src/main.ts",
    "test": "bun test",
    "check": "tsc --noEmit -p tsconfig.json",
    "build": "bun build --compile --minify src/main.ts --outfile dist/llmcli",
    "eval": "bun run evals/run.ts"
  },
  "dependencies": {
    "blessed": "^0.1.81"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/node": "^26.6.5",
    "typescript": "^5.0.0"
  }
}
